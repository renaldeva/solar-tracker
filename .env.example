APP_NAME="Solar Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Feature Flags
FEATURE_BATTERY=false
SOLAR_WIND_STOW_MS=15.0
SOLAR_COMMAND_TIMEOUT_SECONDS=30

# PostgreSQL 16
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=solar_tracker
DB_USERNAME=tracker_user
DB_PASSWORD=secret_password_here
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Eclipse Mosquitto 2 MQTT Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
FORWARD_MQTT_PORT=1883
MQTT_AUTH_USERNAME=solar_backend
MQTT_AUTH_PASSWORD=backend_secret_here

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
